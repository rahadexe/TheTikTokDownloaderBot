name = "tiktok-downloader-bot"
main = "src/worker.js"
compatibility_date = "2024-09-23"
compatibility_flags = ["nodejs_compat"]

[vars]
# Optional custom environment variables:
ADMIN_ID = "6775546602"
CHANNEL_USERNAME = "@RHToolsOfficial"

# Set your BOT_TOKEN securely via Cloudflare Secrets:
# npx wrangler secret put BOT_TOKEN

# Cloudflare D1 Serverless SQL Database Binding
# 1. Create your database:
#    npx wrangler d1 create tiktok_db
# 2. Execute schema:
#    npx wrangler d1 execute tiktok_db --file=./schema.sql
# 3. Paste database_id below and uncomment:
# [[d1_databases]]
# binding = "DB"
# database_name = "tiktok_db"
# database_id = "YOUR_D1_DATABASE_ID_HERE"
